# ---------------------------------------------------------------------------
# Vsoft – Umgebungsvariablen
# Kopieren nach .env.local und Werte aus dem Supabase-Dashboard eintragen.
# ---------------------------------------------------------------------------

# Supabase-Projekt: Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Neuer Schlüssel-Typ ("sb_publishable_...") ODER Legacy-anon-Key (JWT) –
# eine der beiden Variablen reicht.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nur serverseitig (Storage-Admin, spätere Import-Jobs) – NIE im Client nutzen.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres-Verbindung für Drizzle (Dashboard → Connect → Connection String).
# Empfohlen: Session-Pooler (Port 5432). Transaction-Pooler (6543) geht auch,
# der Client ist mit prepare:false bereits darauf eingestellt.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-passwort>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
